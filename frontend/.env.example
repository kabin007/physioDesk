# FastAPI backend base URL. Server-only: the browser never talks to FastAPI directly;
# all API calls go through the Next.js route handlers under /api (BFF), which hold the
# JWTs in httpOnly cookies.
API_URL=http://localhost:8000
API_PREFIX=/api/v1

# Display settings (must match the backend's CLINIC_TIMEZONE).
NEXT_PUBLIC_CLINIC_TIMEZONE=Asia/Kathmandu
# The backend stores amounts without a currency; this is the label shown next to money.
NEXT_PUBLIC_CURRENCY=NPR
