# --- Application --------------------------------------------------------------
APP_NAME=PhysioDesk
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# Matches the Postgres started by `make db-up` (docker-compose.yml). Port 5433 avoids
# clashing with a locally installed Postgres on 5432.
DATABASE_URL=postgresql+asyncpg://physiodesk:physiodesk@localhost:5433/physiodesk
# Optional: tests default to "<DATABASE_URL database>_test" and never touch the dev database.
# TEST_DATABASE_URL=postgresql+asyncpg://physiodesk:physiodesk@localhost:5433/physiodesk_test

# --- Auth ---------------------------------------------------------------------
# Development placeholder only. `make env` replaces it with a random secret; production
# startup refuses placeholder secrets. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=insecure-dev-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- HTTP ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Clinic -------------------------------------------------------------------
# IANA timezone used for "today", clinic-day boundaries and invoice years.
CLINIC_TIMEZONE=Asia/Kathmandu
